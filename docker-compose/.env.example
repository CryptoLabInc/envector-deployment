##############################################
# Docker Compose Configuration
##############################################

# Docker compose setup
COMPOSE_PROJECT_NAME=my_project
VERSION_TAG=latest
IMAGE_DIR=cryptolabinc/
PULL_POLICY=always  # if_not_present if you want to use local images
# Docker volume mount setup
DOCKER_VOLUME_DIRECTORY=./volumes # Set the docker volume mounting directory if needed
DOCKER_VOLUME_DIRECTORY_KMS=./kms-volumes # Separate volume directory for KMS to avoid permission issues with local storage
# Log Level
ENVECTOR_LOG_LEVEL=INFO
# License Key
# ENVECTOR_LICENSE_TOKEN=

##############################################
# Docker Images
##############################################

# Endpoint
ENVECTOR_ENDPOINT_IMAGE_NAME=${IMAGE_DIR}envector-endpoint
ENVECTOR_ENDPOINT_TAG=${VERSION_TAG}
# Backend
ENVECTOR_BACKEND_IMAGE_NAME=${IMAGE_DIR}envector-backend
ENVECTOR_BACKEND_TAG=${VERSION_TAG}
# Shaper
ENVECTOR_SHAPER_IMAGE_NAME=${IMAGE_DIR}envector-shaper
ENVECTOR_SHAPER_TAG=${VERSION_TAG}
# Orchestrator
ENVECTOR_ORCHESTRATOR_IMAGE_NAME=${IMAGE_DIR}envector-orchestrator
ENVECTOR_ORCHESTRATOR_TAG=${VERSION_TAG}
# Compute
ENVECTOR_COMPUTE_IMAGE_NAME=${IMAGE_DIR}envector-compute
ENVECTOR_COMPUTE_TAG=${VERSION_TAG}
# KMS (optional service; enable with ./start_envector.sh --kms)
ENVECTOR_KMS_IMAGE_NAME=${IMAGE_DIR}envector-kms
ENVECTOR_KMS_TAG=${VERSION_TAG}
ENVECTOR_KMS_TEE_IMAGE_NAME=${IMAGE_DIR}envector-kms-tee
ENVECTOR_KMS_TEE_TAG=${VERSION_TAG}
# Audit (optional service; enable with ./start_envector.sh --audit)
ENVECTOR_AUDIT_IMAGE_NAME=${IMAGE_DIR}envector-audit
ENVECTOR_AUDIT_TAG=${VERSION_TAG}

##############################################
# Connection Configurations
##############################################

# Endpoint
ENVECTOR_ENDPOINT_HOST_PORT=50050  # Set your endpoint host port here
ENVECTOR_HTTP_HEALTH_HOST_PORT=18080  # Exposes /health and /health/ready on the host
ENVECTOR_ADMIN_API_ENABLED=true
# KMS (optional service; enable with ./start_envector.sh --kms)
ENVECTOR_KMS_GRPC_HOST_PORT=50090
ENVECTOR_KMS_HTTP_HOST_PORT=50091
# KMS-Audit (optional service; enable with ./start_envector.sh --kms-audit)
ENVECTOR_KMS_AUDIT_HOST_PORT=50053
# Auth (optional service; enable with ./start_envector.sh --keycloak)
KEYCLOAK_HOST_PORT=8082
# Audit (optional service; enable with ./start_envector.sh --audit)
ENVECTOR_AUDIT_HOST_PORT=50052
ENVECTOR_AUDIT_HTTP_HOST_PORT=58052

##############################################
# Infra Configurations
##############################################

# DB
# If ENVECTOR_DB_URL is set, the individual ENVECTOR_DB_* params below are ignored.
ENVECTOR_DB_URL="postgresql://postgres:abcdefghi@metadatadb:5432/mydatabase?sslmode=disable"
# Optional: set individual DB parameters instead of URL
ENVECTOR_DB_HOST=metadatadb
ENVECTOR_DB_PORT=5432
ENVECTOR_DB_USER=postgres
ENVECTOR_DB_PASSWORD=abcdefghi
ENVECTOR_DB_NAME=mydatabase
ENVECTOR_DB_SCHEMA=public
ENVECTOR_DB_SSL=disable
# Optional: external DB endpoint (host:port), e.g. AWS RDS.
# ENVECTOR_DB_ADDRESS=mydb.abcdefghijkl.us-east-1.rds.amazonaws.com:5432

# Storage
ENVECTOR_STORAGE_PROVIDER=s3
ENVECTOR_STORAGE_PORT=59000
ENVECTOR_STORAGE_CONSOLE_PORT=59001
ENVECTOR_STORAGE_USER=minioadmin
ENVECTOR_STORAGE_PASSWORD=abcdefghi
ENVECTOR_STORAGE_SECURE=false # Set to true if using HTTPS
ENVECTOR_STORAGE_BUCKET_NAME=envector
ENVECTOR_STORAGE_CREATE_BUCKET=true
ENVECTOR_STORAGE_HAS_HEALTHCHECK_ENDPOINT=true # Set to true if storage has health check endpoint
ENVECTOR_STORAGE_REGION=us-east-1
# Cap MinIO Go runtime parallelism (defaults to 16). Uncomment compose `cpus` to also hard-limit.
# ENVECTOR_STORAGE_GOMAXPROCS=16

##############################################
# KMS Configurations (optional service; enable with ./start_envector.sh --kms)
##############################################

# KMS PubKey Storage
ENVECTOR_KMS_MINIO_ENDPOINT=kms-storage:9000
ENVECTOR_KMS_MINIO_BUCKET=kms-keys
ENVECTOR_KMS_MINIO_ACCESS_KEY=minioadmin
ENVECTOR_KMS_MINIO_SECRET_KEY=minioadmin
# KMS SecKey Storage
# Secret-manager backend: "vault" (default) or "bao" (OpenBao). OpenBao is a
# wire-compatible Vault fork, so switching backends means switching ONLY the
# container image below — set these two together (.env is static key=value with
# no conditionals, so the image cannot be derived from the backend automatically).
ENVECTOR_KMS_SECRET_BACKEND=vault
# Secret-manager container image — pick the one matching the backend above:
#   vault: ENVECTOR_KMS_SM_IMAGE=hashicorp/vault:1.20   ENVECTOR_KMS_SM_BIN=vault
#   bao:   ENVECTOR_KMS_SM_IMAGE=openbao/openbao:2.5.5  ENVECTOR_KMS_SM_BIN=bao
# (start_envector.sh sets these for you when ENVECTOR_KMS_SECRET_BACKEND=bao.)
ENVECTOR_KMS_SM_IMAGE=hashicorp/vault:1.20
ENVECTOR_KMS_SEAL_MODE=vault-transit
ENVECTOR_KMS_TRANSIT_MOUNT=transit
ENVECTOR_KMS_SECRET_MANAGER_ADDR=https://kms-secret-manager:8200
ENVECTOR_KMS_SECRET_MANAGER_MOUNT=secret
# Require https:// + CA/mTLS on the kms-tee->secret-manager link; refuse startup otherwise.
ENVECTOR_KMS_REQUIRE_SM_TLS=true

# --- GCP-native KMS backend (ENVECTOR_KMS_SECRET_BACKEND=gcp) ---------------------
# Uncomment and set these when running the GCP-native backend (Cloud KMS + Secret
# Manager) instead of vault/bao. PROJECT is your GCP project id; KMS_KEYRING / KMS_KEY
# are the Cloud KMS keyring and the KEK the backend seals secret keys under. The
# per-role SA (ENVECTOR_KMS_GCP_SA_*), WIF audience, per-type metadata CMEK, and
# attested-base vars are provisioned by the gcp/kms-wif + gcp/kms-iam terraform and
# emitted by the Confidential Space launcher — see
# docs/runbooks/kms/confidential-space-attested-kms-tee-e2e.md.
#ENVECTOR_KMS_GCP_PROJECT=your-gcp-project-id
#ENVECTOR_KMS_GCP_KMS_KEYRING=envector-kms
#ENVECTOR_KMS_GCP_KMS_KEY=envector-kek

# --- YubiHSM2 auto-unseal + HSM-managed root token -------------------------------
# For `scripts/start_envector.sh --kms-hsm` against a REAL YubiHSM2 (bao backend,
# RSA-OAEP). Host prereqs: a yubihsm-connector bound 0.0.0.0:12345 (or the port
# in ENVECTOR_KMS_YUBIHSM_CONNECTOR_URL), and two RSA decrypt-oaep keys on the HSM
# (labels: bao-unseal, envector-kms-roottoken).
#
# IMPORTANT — the two SELECTOR vars below must be in the SHELL ENVIRONMENT
# (exported / prefixed on the command), NOT just here: start_envector.sh does not
# source .env into its own shell, and its overlay-selection logic reads the shell
# env. Setting them only in .env leaves the run on the SoftHSM path.
#   export ENVECTOR_KMS_YUBIHSM_LIB_DIR=/path/to/yubihsm-libs   # dir with linux yubihsm_pkcs11.so + libyubihsm*.so (+ deps)
#   export ENVECTOR_KMS_HSM_ROOT_TOKEN=true                     # also HSM-seal the root token (restart auto-recovery)
#
# The rest are compose/wrapper tuning values (defaults shown); uncomment to
# override. The connector URL is consumed by scripts/start_envector.sh to generate
# the PKCS#11 module conf, and the kms-tee-side PKCS#11 params default to YubiHSM2.
# ENVECTOR_KMS_SECRET_MANAGER_AUTO_UNSEAL=true          # set by --kms-hsm; recovery_shares init contract
# ENVECTOR_KMS_YUBIHSM_IMAGE=openbao/openbao-hsm-ubi:latest
# ENVECTOR_KMS_YUBIHSM_CONNECTOR_URL=http://host.docker.internal:12345
# ENVECTOR_KMS_YUBIHSM_PIN=0001password                 # <4-hex-authkey-id><user-password>
# ENVECTOR_KMS_YUBIHSM_KEY_LABEL=bao-unseal             # bao auto-unseal RSA key label
# ENVECTOR_KMS_HSM_ROOT_TOKEN_KEY_LABEL=envector-kms-roottoken   # root-token wrapping RSA key label (distinct key)
# ENVECTOR_KMS_HSM_OAEP_HASH=sha256                     # sha256 (YubiHSM2) | sha1 (SoftHSM2)
# ENVECTOR_KMS_HSM_SLOT=0                               # YubiHSM PKCS#11 slot is always 0

# KMS SecKey Storage (GCP backend alternative to the Vault vars above).
# Used by docker-compose.kms-gcp.yml instead of Vault: sealed keys live in GCP
# Secret Manager and the KEK is a Cloud KMS CMEK. Set ENVECTOR_KMS_SECRET_BACKEND=gcp
# to select this path; the GCP env + ADC are read ONLY by envector-kms-tee.
# ENVECTOR_KMS_SECRET_BACKEND=gcp
# GCP project that owns the Secret Manager secrets and Cloud KMS key ring.
# ENVECTOR_KMS_GCP_PROJECT=my-gcp-project
# Cloud KMS key ring (must pre-exist; location "global" for P0).
# ENVECTOR_KMS_GCP_KMS_KEYRING=envector-kms
# Cloud KMS CryptoKey (CMEK) used to wrap/unwrap the DEK envelope.
# ENVECTOR_KMS_GCP_KMS_KEY=envector-kek
# Optional: a DISTINCT crypto key in the same keyring to wrap the metadata DEK
# (per-type CMEK split). When set, metadata-cipher decrypts only this key, never
# the sk key. Leave unset for a single-CMEK deployment. Must differ from KMS_KEY.
# ENVECTOR_KMS_GCP_KMS_KEY_METADATA=envector-kek-meta
# Name prefix for the sealed-key secrets created in Secret Manager.
# ENVECTOR_KMS_GCP_SECRET_PREFIX=envector-kms
#
# Per-role least-privilege (ES2-2107): impersonate a distinct service account
# per TEE role so one role's credential cannot act as another. Set ALL FIVE for
# per-role mode, or NONE to share the ambient credential (single-SA, default); a
# partial set, or duplicate SAs across roles, is rejected at startup. Each SA gets
# ONLY its role's IAM, and the direct Secret Manager / Cloud KMS roles move OFF
# the base identity onto the per-role SAs. Secret Manager grants split by whether
# the role mutates the KeyStore:
#   (There is NO secretmanager.secrets.access permission; payload reads are
#   secretmanager.versions.access — GCP rejects a custom role with secrets.access.)
#   SM WRITE = secrets.{create,get,list,delete} + versions.{access,add,get,list,
#     disable,destroy}  (roles/secretmanager.admin or an equivalent custom role).
#     versions.access: keygen/rotate READ record/key payloads via AccessSecretVersion.
#     versions.get + versions.list: rotate's DeactivateSecKey resolves "latest" via
#     GetSecretVersion and DestroySecKey iterates ListSecretVersions.
#   SM READ (payload) = secrets.get + versions.access (roles/secretmanager.secretAccessor)
#     — covers AccessSecretVersion, the only SM call on the decrypt-only data path.
#   SM LIST (inventory) = + secrets.list + versions.list (roles/secretmanager.viewer)
#     — for ListSecrets / ListSecretVersions.
#   - keygen:          SM WRITE + cloudkms encrypt + cloudkms.viewer
#                      (cloudkms.cryptoKeys.get) — EnsureKEK reads the CMEK with
#                      GetCryptoKey and hard-fails without get.
#   - rotate:          SM WRITE + cloudkms encrypt/decrypt + cloudkms.cryptoKeyVersions.create
#                      + cloudkms.cryptoKeys.update (or roles/cloudkms.admin) —
#                      rotate_kek creates a new CMEK version and promotes to primary.
#                      cloudkms.viewer is OPTIONAL (best-effort, non-fatal Get).
#   - score-decryptor,
#     metadata-cipher: SM READ (payload) + cloudkms DECRYPT only. Data path is
#                      AccessSecretVersion + Cloud KMS Decrypt (Unseal) — no
#                      GetCryptoKey, no encrypt, and no list. (Their Health RPC
#                      calls ListSecrets, so add secretmanager.viewer ONLY if you
#                      probe the per-role Health RPC; the container healthcheck
#                      uses a static status and does not.)
#   - key-info:        SM READ (payload) + SM LIST, no Cloud KMS. Key-INVENTORY
#                      role: ListKeyIDs -> ListSecrets, ListVersions ->
#                      ListSecretVersions, GetRecord -> AccessSecretVersion. NOT
#                      the vector-metadata field cipher (that is metadata-cipher
#                      above, EncryptMetadata/DecryptMetadata).
# The base/attested identity (the ADC mounted into kms-tee) needs ONLY
# roles/iam.serviceAccountTokenCreator on each of the 5 SAs in per-role mode — do
# NOT also grant it secretmanager.admin or cloudkms.cryptoKeyEncrypterDecrypter.
# It is used solely to mint impersonation tokens; granting it the data-plane
# roles would let the credential read/unseal keys directly and bypass the
# per-role least-privilege boundary. Per-role mode also requires the IAM
# Credentials API (iamcredentials.googleapis.com) enabled: impersonation mints
# tokens through it, so the first per-role RPC fails without it even when the IAM
# grants are correct. NOTE (user-ADC edge): when the base credential is a local
# user ADC (authorized_user) with a quota project set, generateAccessToken may
# additionally require the target SAs to hold serviceusage.services.use
# (roles/serviceusage.serviceUsageConsumer) on the quota project — grant it if a
# per-role RPC fails PERMISSION_DENIED on Service Usage. A workload-identity /
# attested-SA base does not need this.
# ENVECTOR_KMS_GCP_SA_KEYGEN=envector-kms-keygen@my-gcp-project.iam.gserviceaccount.com
# ENVECTOR_KMS_GCP_SA_ROTATE=envector-kms-rotate@my-gcp-project.iam.gserviceaccount.com
# ENVECTOR_KMS_GCP_SA_KEY_INFO=envector-kms-key-info@my-gcp-project.iam.gserviceaccount.com
# ENVECTOR_KMS_GCP_SA_SCORE_DECRYPTOR=envector-kms-score-decryptor@my-gcp-project.iam.gserviceaccount.com
# ENVECTOR_KMS_GCP_SA_METADATA_CIPHER=envector-kms-metadata-cipher@my-gcp-project.iam.gserviceaccount.com
# Host path to Application Default Credentials, mounted read-only into the TEE.
# Defaults to the gcloud ADC file; point at a service-account key json instead.
# GCP_ADC_PATH=${HOME}/.config/gcloud/application_default_credentials.json
# Attested-base guard: when true, the GCP backend refuses to start
# unless the base credential is a Workload Identity Federation external_account
# (minted from a Confidential Space attestation token) — a static SA key, user
# ADC, or GCE metadata credential is rejected. Leave false for P0/P1 (ambient
# ADC); set true in the attested P2 deployment so no stealable static base key.
# ENVECTOR_KMS_GCP_REQUIRE_ATTESTED_BASE=false
# The attested base SA the per-role SAs are impersonated from. When attestation is
# required, the guard pins the impersonated SA to this exact value; unset -> it falls
# back to the weaker "any SA in the project" check.
# ENVECTOR_KMS_GCP_BASE_SA=envector-kms-tee-attested@my-gcp-project.iam.gserviceaccount.com
# Exact WIF provider audience (from the kms-wif terraform output). When attestation is
# required and this is set, the base ADC must federate through exactly this provider, so
# a stale/other provider in the same pool (which carries a different image/env attribute
# condition) is rejected. Unset -> only the audience shape is validated (warning logged).
# ENVECTOR_KMS_GCP_WIF_AUDIENCE=//iam.googleapis.com/projects/<PROJECT_NUMBER>/locations/global/workloadIdentityPools/<POOL>/providers/<PROVIDER>
# Shared local PKI compose defaults
STEP_CA_NAME=envector-local-ca
STEP_CA_DNS=step-ca,localhost,127.0.0.1
STEP_CA_ADDRESS=:9000
STEP_CA_PROVISIONER=envector-workloads
# Optional local provisioner password. Leave empty to auto-generate it into
# /step-secrets/step_ca_password in the envector-ca-secrets compose volume.
STEP_CA_PASSWORD=
STEP_CA_X509_DEFAULT_DUR=8760h
STEP_CA_X509_MAX_DUR=8760h
STEP_CA_URL=https://step-ca:9000
# CN is the certificate subject. SAN values are what modern TLS clients use
# for server name/IP verification.
SM_TLS_CN=kms-secret-manager
SM_TLS_DNS=kms-secret-manager,localhost
SM_TLS_IP=127.0.0.1
KMS_TEE_TLS_CN=envector-kms-tee
KMS_TEE_TLS_DNS=envector-kms-tee
KMS_API_TLS_CN=envector-kms
KMS_API_TLS_DNS=envector-kms,localhost
KMS_API_TLS_IP=127.0.0.1  # add your IP here if you use IP-based addressing for KMS API clients
# KMS TEE score decrypt worker count for DecryptBatchTopK.
ENVECTOR_KMS_DECRYPT_TOPK_JOBS=1
# ENVECTOR_KMS_TEE_GOMAXPROCS=
# KMS Auth
# Uncomment when using local KMS + Keycloak auth together.
# ENVECTOR_KMS_AUTH_JWKS_URL=http://keycloak:8080/realms/envector/protocol/openid-connect/certs
# ENVECTOR_KMS_AUTH_OIDC_ISSUER=http://localhost:8082/realms/envector
# ENVECTOR_KMS_AUTH_ALLOWED_AUDIENCES=envector-cli
# ENVECTOR_KMS_AUTH_ROLE_CLAIM=envector_roles
# ENVECTOR_KMS_AUTH_PRINCIPAL_CLAIM=principal_id
# ENVECTOR_KMS_AUTH_CAPABILITY_POLICY_JSON=
# KMS Audit
ENVECTOR_KMS_AUDIT_EXPORT_REQUIRE_PRINCIPAL=true
ENVECTOR_KMS_AUDIT_LOG_INCLUDE_IDENTITY_CLAIMS=false
# KMS Audit Storage
ENVECTOR_KMS_AUDIT_STORAGE_PROVIDER=s3
ENVECTOR_KMS_AUDIT_STORAGE_ADDRESS=kms-storage:9000
ENVECTOR_KMS_AUDIT_STORAGE_BUCKET_NAME=envector-kms-audit
ENVECTOR_KMS_AUDIT_STORAGE_USER=minioadmin
ENVECTOR_KMS_AUDIT_STORAGE_PASSWORD=minioadmin
ENVECTOR_KMS_AUDIT_STORAGE_REGION=us-east-1
ENVECTOR_KMS_AUDIT_STORAGE_SECURE=false

##############################################
# Auth N/Z Configurations (optional service; enable with ./start_envector.sh --keycloak)
##############################################

# Auth
ENVECTOR_AUTH_ROLE_CLAIM=envector_roles
ENVECTOR_AUTH_PRINCIPAL_CLAIM=principal_id
ENVECTOR_AUTH_JWKS_URL=
# JWT validation clock-skew tolerance in seconds (default 0 = strict). Applies to
# exp/nbf checks across all JWKS verifiers. Recommended 30-60 in production.
# ENVECTOR_JWT_LEEWAY_SECONDS=0
# Uncomment when using local KMS + Keycloak auth together.
# ENVECTOR_AUTH_OIDC_ISSUER=http://localhost:8082/realms/envector
# ENVECTOR_AUTH_ALLOWED_AUDIENCES=envector-cli
# ENVECTOR_AUTH_CAPABILITY_POLICY_JSON=http://keycloak:8080/realms/envector/protocol/openid-connect/certs

# keycloak (recommended local auth overlay for v3)
KEYCLOAK_REALM=envector
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=kcadmin
# Password for the dedicated least-privilege `keycloak` Postgres role (bundled
# Keycloak's persistent store). Set a strong value for production.
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_CLIENT_ID=envector-cli
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_TOKEN_SCOPES="openid profile email"
KEYCLOAK_LOCAL_USER_PASSWORD=password
KEYCLOAK_LOCAL_TENANT_ID=tenant-a
KEYCLOAK_TEST_ALLOWED_AUDIENCES=envector-cli,envector-api
KEYCLOAK_TEST_ROLE_CLAIM=envector_roles
KEYCLOAK_TEST_PRINCIPAL_CLAIM=principal_id
KEYCLOAK_TEST_JWKS_URL=http://keycloak:8080/realms/envector/protocol/openid-connect/certs
KEYCLOAK_TEST_AUTH_CAPABILITY_POLICY_JSON={"role_capabilities":{"security":["read","write","owner_bypass"],"ops":["read"],"app":["read","write"]}}

##############################################
# Audit Configurations (optional service; enable with ./start_envector.sh --audit)
##############################################

# audit configuration
AUDIT_EXPORT_REQUIRE_PRINCIPAL=false  # Set to true in production
AUDIT_LOG_SINK=file
AUDIT_LOG_INCLUDE_IDENTITY_CLAIMS=false
# audit auth
ENVECTOR_AUDIT_AUTH_OIDC_ISSUER=
ENVECTOR_AUDIT_AUTH_JWKS_URL=http://keycloak:8080/realms/envector/protocol/openid-connect/certs
ENVECTOR_AUDIT_AUTH_EXPECTED_ISSUER=http://localhost:8082/realms/envector
ENVECTOR_AUDIT_AUTH_ALLOWED_AUDIENCES=envector-cli
# audit storage configuration
ENVECTOR_AUDIT_STORAGE_PROVIDER=s3
ENVECTOR_AUDIT_STORAGE_ADDRESS=storage:59000  # Set to audit-storage:59000 in production
ENVECTOR_AUDIT_STORAGE_BUCKET_NAME=envector-audit
ENVECTOR_AUDIT_STORAGE_USER=minioadmin
ENVECTOR_AUDIT_STORAGE_PASSWORD=abcdefghi
ENVECTOR_AUDIT_STORAGE_SECURE=false
ENVECTOR_AUDIT_STORAGE_REGION=us-east-1
# In production, separate audit storage instance is recommended.
# Uncomment `audit-storage` service from envector storage in docker-compose.audit.yml.
# ENVECTOR_AUDIT_STORAGE_ADDRESS=audit-storage:59000
# In production, object lock must be set.
# ENVECTOR_AUDIT_OBJECT_LOCK_ENABLED=true
# ENVECTOR_AUDIT_OBJECT_LOCK_MODE=COMPLIANCE
# ENVECTOR_AUDIT_RETENTION_DAYS=2190  # 6 years

##############################################
# GPU Configuration (if needed)
##############################################

# ENVECTOR_COMPUTE GPU ID
# ENVECTOR_COMPUTE_GPU0_ID=0
# ENVECTOR_COMPUTE_GPU1_ID=1
# ENVECTOR_COMPUTE_GPU2_ID=2
# ENVECTOR_COMPUTE_GPU3_ID=3

##############################################
# Advanced runtime options
##############################################

# Backend
# ENVECTOR_MAX_NUM_VECTORS_PER_SHARD=4096
# CTXTMAP_READ_BATCH_SIZE=4096
# CTXTMAP_INSERT_BATCH_SIZE=4096
# CTXTMAP_WRITE_BATCH_SIZE=4096
# METADATA_INSERT_BATCH_SIZE=8192
# METADATA_WRITE_BATCH_SIZE=8192
# ENVECTOR_CLEANUP_GRACE_PERIOD=5m
# VCT_CAPACITY=4096
# ENVECTOR_LOAD_INDEX_SHARD_CONCURRENCY=32
# ENVECTOR_BASELINE_INSERTABLE_SHARDS=8

# Shaper
# ENVECTOR_SHAPER_MAX_WORKERS=16
# ENVECTOR_SHAPER_CLEANUP_PERIOD=1h
# ENVECTOR_SHAPER_JOB_TTL=24h
# ENVECTOR_SHAPER_SPLIT_UPLOAD_CONCURRENCY=1
# ENVECTOR_SHAPER_MERGE_DOWNLOAD_CONCURRENCY=1
# MALLOC_ARENA_MAX=2

# Compute
# NUM_SEARCH_WORKERS=30
# Per-service CPU pinning (cpuset). On multi-socket (NUMA) hosts, pin compute to a
# single NUMA node's physical cores (support services to another node) to avoid
# cross-socket memory traffic. Empty = no pinning. Find node CPUs via
# `lscpu | grep NUMA`. Tip: `start_envector.sh --numa-auto` auto-detects the
# topology and sets all of these for you (`--numa-heavy` for high-nprobe workloads).
# ENVECTOR_COMPUTE_CPUSET=0-23,48-55
# ENVECTOR_ORCHESTRATOR_CPUSET=
# ENVECTOR_BACKEND_CPUSET=
# ENVECTOR_ENDPOINT_CPUSET=
# ENVECTOR_SHAPER_CPUSET=
# CPU quota (cfs) for compute, in cores. Set together with COMPUTE_CPUSET when pinning
# manually: cpuset alone changes WHERE it runs, not HOW MUCH CPU-time it gets, so a
# stale low quota here throttles compute even on a wide cpuset. --numa-auto sets it to
# match the pinned core count.
# ENVECTOR_COMPUTE_CPUS=24
# numa_autopin.sh tuning knobs (used by --numa-auto): worker:core ratio, hard core cap,
# and workload profile. See scripts/numa_autopin.sh for the measured defaults.
# ENVECTOR_WORKER_RATIO=1.3
# ENVECTOR_COMPUTE_MAX_CORES=24
# ENVECTOR_COMPUTE_PROFILE=light   # light|heavy (heavy = dual-socket for high-nprobe)
